# Base URL of the ApparcaCUC API.
# In local development, leave this BLANK — Vite proxies /api to http://localhost:4000.
# In production, set the deployed backend URL including the /api suffix, e.g.
#   VITE_API_URL=https://apparcacuc-api.onrender.com/api
#
# NOTE: anything prefixed with VITE_ is embedded in the public bundle. Never put
# secrets here — only public configuration.
VITE_API_URL=
