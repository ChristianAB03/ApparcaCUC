# ─────────────────────────────────────────────────────────────
#  ApparcaCUC · API environment
#  Copy this file to `.env` and fill in the values.
#  NEVER commit `.env` (it is git-ignored). These are names only.
# ─────────────────────────────────────────────────────────────

# Runtime environment: development | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Allowed frontend origin(s) for CORS (comma-separated, no trailing slash)
CLIENT_URL=http://localhost:5173

# MongoDB connection string.
# Leave BLANK in local development to auto-start an in-memory MongoDB
# (no install required). In production, set your MongoDB Atlas URI here:
#   mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWTs. In production use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed demo data automatically when the database is empty (true | false)
SEED_ON_START=true

# Demo credentials used by the seed script (fictional accounts only)
DEMO_USER_EMAIL=demo@apparcacuc.com
DEMO_USER_PASSWORD=Demo123!
DEMO_ADMIN_EMAIL=admin@apparcacuc.com
DEMO_ADMIN_PASSWORD=Admin123!
